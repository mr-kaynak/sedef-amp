{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CPM_SOURCE_CACHE": "$env{HOME}/.cache/CPM"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug, everything",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release, everything",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "engine",
      "displayName": "Engine + tests only (no JUCE)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SEDEF_BUILD_PLUGIN": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Engine tests with ASan + UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SEDEF_BUILD_PLUGIN": "OFF",
        "SEDEF_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "engine", "configurePreset": "engine" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "engine", "configurePreset": "engine", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
