    "rippleSpeed": 0.7,
    "rippleDepth": 0.2,
    "driftEnabled": 1,
    "driftHeads": 1,
    "driftNote": 12,
    "driftMix": 0.22,
    "driftFeedback": 0.35,
    "fathomEnabled": 1,
    "fathomMix": 0.2,
    "fathomDecay": 3.5,
    "gateThreshold": -62.0,
    "abyssOutput": 0.2751
  }
