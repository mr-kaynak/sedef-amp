{
  "format": "sedef-preset",
  "version": 1,
  "id": "bioluminescence",
  "name": "Chorus Echo Lead",
  "folder": "Lead",
  "author": "Sedef",
  "tags": ["boost", "chorus", "delay", "solo"],
