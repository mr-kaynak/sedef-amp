{
  "format": "sedef-preset",
  "version": 1,
  "name": "Coral Fuzz",
  "folder": "High Gain",
  "author": "Sedef",
  "tags": [
    "distortion",
    "rhythm",
    "garage"
  ],
  "description": "Hard-clipped distortion into a gritty amp. Raw, compressed garage riffs.",
  "board": ["gate", "coral"],
  "parameters": {
    "ampModel": 1,
    "reefGain": 0.24,
    "coralEnabled": 1,
    "coralGain": 0.6,
    "coralCut": 0.4,
    "coralLevel": 0.55,
    "gateThreshold": -64.0,
    "reefOutput": 0.3187
  }
}
