{
  "format": "sedef-preset",
  "version": 1,
  "name": "Glass Pocket",
  "folder": "Clean",
  "author": "Sedef",
  "tags": [
    "compressor",
    "delay",
    "neo-soul",
    "funk"
  ],
  "description": "Snappy compressed clean for funk comping, dotted-eighth echo underneath.",
  "board": ["gate", "tide"],
  "parameters": {
    "ampModel": 0,
    "micAPosition": 0.4,
    "micBEnabled": 1,
    "micBCab1Type": 8,
    "micBDistance": 0.25,
    "micBLevel": -5.0,
    "lagoonVolume": 0.5,
    "lagoonBass": 0.45,
    "lagoonCut": 0.3,
    "tideEnabled": 1,
    "tideComp": 0.62,
    "tideTone": 0.58,
    "tideBlend": 0.75,
    "driftEnabled": 1,
    "driftNote": 12,
    "driftMix": 0.18,
    "driftFeedback": 0.25,
    "fathomEnabled": 1,
    "fathomMix": 0.18,
    "fathomDecay": 1.8,
    "lagoonOutput": 0.5667
  }
}
