{
  "format": "sedef-preset",
  "version": 1,
  "name": "Harbor Lights",
  "folder": "Crunch",
  "author": "Sedef",
  "tags": [
    "slapback",
    "rockabilly"
  ],
  "description": "Mid-gain crunch with a tape slapback, for rockabilly and early rock.",
  "board": ["gate"],
  "parameters": {
    "ampModel": 1,
    "reefGain": 0.38,
    "driftEnabled": 1,
    "driftHeads": 0,
    "driftSync": 0,
    "driftTime": 120.0,
    "driftFeedback": 0.12,
    "driftMix": 0.25,
    "driftTapeMod": 0.35,
    "reefOutput": 0.4083
  }
}
