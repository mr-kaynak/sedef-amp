{
  "format": "sedef-preset",
  "version": 1,
  "id": "jet-flange",
  "name": "Jet Flange",
  "folder": "Lead",
  "author": "Sedef",
  "tags": ["flanger", "delay", "solo"],
  "description": "High-gain lead with a slow jet sweep across it. Held bends and dive bombs.",
  "board": ["gate", "jetty"],
  "parameters": {
