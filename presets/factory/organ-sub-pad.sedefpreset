{
  "format": "sedef-preset",
  "version": 1,
  "id": "organ-sub-pad",
  "name": "Organ Sub Pad",
  "folder": "Ambient",
  "author": "Sedef",
  "tags": ["octave", "chorus", "hall", "pad"],
  "description": "Chords with one and two octaves below and a slow chorus: an organ-like pad in a hall.",
  "board": ["gate", "trench", "ripple"],
  "parameters": {
    "ampModel": 0,
    "micAPosition": 0.4,
    "micBDistance": 0.25,
    "micBLevel": -5.0,
    "lagoonVolume": 0.4,
    "lagoonCut": 0.5,
    "trenchEnabled": 1,
    "trenchMode": 1,
    "trenchDirect": 0.5,
    "trenchSub1": 0.5,
    "trenchSub2": 0.25,
    "trenchTone": 0.5,
    "rippleEnabled": 1,
    "rippleMode": 1,
    "rippleSpeed": 1.2,
    "rippleDepth": 0.5,
    "fathomEnabled": 1,
    "fathomMode": 1,
    "fathomMix": 0.4,
    "fathomDecay": 6.0,
    "lagoonOutput": 0.5417
  }
}
