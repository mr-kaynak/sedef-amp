{
  "format": "sedef-preset",
  "version": 1,
  "id": "silk-road",
  "name": "Classic Rock Boost",
  "folder": "Crunch",
  "author": "Sedef",
  "tags": ["boost", "rock"],
  "description": "Boosted crunch that stays tight. Classic rock rhythm and solos.",
  "board": ["gate", "pearl"],
  "parameters": {
    "ampModel": 1,
    "reefVoice": 1,
    "reefGain": 0.31,
    "reefBass": 0.5,
    "reefMid": 0.55,
    "reefTreble": 0.55,
    "pearlEnabled": 1,
    "pearlGain": 0.12,
    "pearlLevel": 0.72,
    "pearlMid": 0.2,
    "micADistance": 0.1,
    "fathomEnabled": 1,
    "fathomMix": 0.14,
    "reefOutput": 0.3292
  }
}
